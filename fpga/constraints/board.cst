// Official schematic rev1.30: header J6/1 is IC pin73 (IOT40A),
// J6/2 is IC pin74 (IOT34B); both bank1 is powered from +3V3.
IO_LOC "clk_27m" 4;
IO_PORT "clk_27m" IO_TYPE=LVCMOS33;
IO_LOC "status_led_n" 18;
IO_PORT "status_led_n" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "xiao_rx" 73;
IO_PORT "xiao_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "xiao_tx" 74;
IO_PORT "xiao_tx" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "uart_tx" 69;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 DRIVE=8;
INS_LOC "u_clock/u_pll" PLL_L;
